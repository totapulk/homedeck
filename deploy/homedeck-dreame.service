[Unit]
Description=HomeDeck vacuum sidecar
Documentation=https://github.com/totapulk/homedeck
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%DEPLOY_USER%
WorkingDirectory=/opt/homedeck-sidecar

# Cloud credentials, kept out of the unit file and out of the repository. Create it with
# mode 600; see deploy/README.md.
EnvironmentFile=/etc/homedeck/dreame.env

ExecStart=/opt/homedeck-sidecar/.venv/bin/python homedeck_dreame.py

# The cloud is not always there, and a failed login should not be permanent.
Restart=always
RestartSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/homedeck-sidecar

[Install]
WantedBy=multi-user.target
