// Copy this file to appsettings.local.json and fill in your own bulbs. That file is ignored by
// git, so nobody has to publish a map of their home to run this project.
//
// Device ids are bulb MAC addresses, exactly as getPilot reports them. To list the ones on your
// network:
//
//     dotnet run --project backend/tools/WizProbe -- discover
//
// To work out which bulb is which, ask the API to blink one and watch the room:
//
//     POST /api/lights/{id}/state   { "isOn": true, "brightness": 100 }
//
// The addresses below are the ones RFC 7042 reserves for documentation; they match no real
// device. Anything you leave out still appears in the app, named after its device id.
{
  "HomeDeck": {
    "Lights": {
      "00005e005301": { "Name": "Reading lamp", "Room": "Living room" },
      "00005e005302": { "Name": "Ceiling", "Room": "Living room" },
      "00005e005303": { "Name": "Desk", "Room": "Office" }
    }
  }
}
