@HomeDeck_HostAddress = http://localhost:5080

# Replace with an id from GET /api/lights below. The default is a documentation address
# (RFC 7042) and matches no real bulb.
@lightId = 00005e005301

### Every known light, as last confirmed by the bulbs themselves
GET {{HomeDeck_HostAddress}}/api/lights
Accept: application/json

### Force a re-discovery instead of waiting for the poller
POST {{HomeDeck_HostAddress}}/api/lights/refresh

### Absolute brightness
POST {{HomeDeck_HostAddress}}/api/lights/{{lightId}}/state
Content-Type: application/json

{ "brightness": 60 }

### Relative nudge — this is what the rotary knob sends
POST {{HomeDeck_HostAddress}}/api/lights/{{lightId}}/state
Content-Type: application/json

{ "brightnessDelta": -10 }

### Off
POST {{HomeDeck_HostAddress}}/api/lights/{{lightId}}/state
Content-Type: application/json

{ "isOn": false }
