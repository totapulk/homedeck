{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Device ids are bulb MAC addresses as reported by getPilot; run WizProbe discover to list them.
  // Bulbs that are not listed here still show up in the API, named after their MAC.
  "HomeDeck": {
    "Lights": {
      // Identified with a blink sweep: bulb N blinked N times, so a room could be
      // recognised from a single pass without watching the clock.
      "444f8eb4a2e2": { "Name": "Living room 1", "Room": "Living room" },
      "444f8eb4a92e": { "Name": "Living room 2", "Room": "Living room" },
      "cc4085bd03ea": { "Name": "Living room 3", "Room": "Living room" }
    }
  }
}
