{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Which bulb is called what is a fact about one particular home, not about this software,
  // so the mapping lives in appsettings.local.json, which is not in version control.
  // Copy appsettings.local.template.json to start your own. Bulbs that are named nowhere
  // still show up in the API, named after their device id.
  "HomeDeck": {
    "Lights": {}
  }
}
